class Solution {
public:
//O(2^n) time complexity without memoisation
//with memoisation O(n^2) both TC and SC
    vector<vector<int>>dp;
    int solve(string &s, int i, int j){
        if(i>=j) return 0;
        if(dp[i][j]!=-1) return dp[i][j];
        if(s[i]==s[j]) return dp[i][j]=solve(s, i+1, j-1);
        if(s[i]!=s[j]) return dp[i][j]=1+min(solve(s, i+1, j), solve(s, i, j-1));
        return 0;
    }
    int minInsertions(string s) {
        int n=s.size();
        dp.assign(n, vector<int>(n, -1)); //resize and initialise existing vector
        return solve(s, 0, n-1);
    }
};
