class Solution {
public:
    int findMin(vector<int>& nums) {
        int st=0, end=nums.size()-1;
        while(st<end){
            while(st<nums.size()-1 && nums[st]==nums[st+1]) st++;
            while(end>0 && nums[end]==nums[end-1]) end--;
            int mid=st+(end-st)/2;
            if(nums[mid]<=nums[end]) end=mid;
            else st=mid+1;
        }
        return nums[st];
    }
};
