class Solution {
public:
    bool asteroidsDestroyed(int mass, vector<int>& asteroids) {
        sort(asteroids.begin(), asteroids.end());
        long long m=mass;
        for(int i=0; i<asteroids.size(); i++){
            if(asteroids[asteroids.size()-1]<m) return true;
            if(asteroids[i]>m) return false;
            m+=asteroids[i];
        }
        return true;
    }
};
