        int n=matrix.size(), m=matrix[0].size();
        vector<bool>rows(n, 0), cols(m, 0);
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                if(matrix[i][j]==0){
                    rows[i]=1;
                    cols[j]=1;
                }
            }
        }
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                if(rows[i] || cols[j]) matrix[i][j]=0;
            }
        }
    }
