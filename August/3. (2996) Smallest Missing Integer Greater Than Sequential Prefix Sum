class Solution {
public:
    int missingInteger(vector<int>& nums) {
        int x=nums[0], n=nums.size();
        for(int i=1; i<n; i++){
            if(nums[i]!=nums[i-1]+1){
                break;
            }else{
                x+=nums[i];
            }
        }
        while(1){
            if(find(nums.begin(), nums.end(), x)==nums.end()){
                return x;
            }
            x++;
        }
        return nums[0];
    }
};
