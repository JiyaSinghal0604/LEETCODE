class Solution {
public:
    string smallestSubsequence(string s) {
        vector<int>freq(26, 0);
        vector<bool>used(26, false);
        for(char c:s){
            freq[c-'a']++;
        }
        string res="";
        for(char c:s){
            freq[c-'a']--;
            if(used[c-'a']) continue;
            while(!res.empty() && res.back()>c && freq[res.back()-'a']>0){
                used[res.back()-'a']=false;
                res.pop_back();
            }
            res.push_back(c);
            used[c-'a']=true;
        }
        return res;
    }
};
